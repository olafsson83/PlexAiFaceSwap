# Copy this file to .env and fill in your own values. .env is gitignored.

# From Plex: play anything -> (...) menu -> Get Info -> View XML -> read the
# host:port from the address bar and the X-Plex-Token= value from the URL.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=your-plex-token-here

# Must match your library names exactly as shown in the Plex sidebar,
# comma-separated.
LIBRARY_NAMES=Movies,TV Shows

# Your source face photo: front-facing, well-lit, at least 512x512.
SOURCE_FACE=my_face.jpg

# Where downloaded/swapped posters are written (relative to repo root).
POSTERS_DIR=posters_original
SWAPPED_DIR=posters_swapped

# insightface device index: 0 = first GPU, -1 = CPU only.
CTX_ID=0
